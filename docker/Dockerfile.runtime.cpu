# cosmium runtime image — CPU/SwiftShader variant.
#
# For hosts without GPU passthrough. Heavier on the patch surface:
# canvas/WebGL pixel hashes must be spoofed via deterministic-noise patch
# (0013) since SwiftShader output is otherwise distinct from real GPUs.
#
# Build:
#   docker build -f docker/Dockerfile.runtime.cpu \
#     --build-arg COSMIUM_TARBALL=dist/cosmium-135.0.7049.84.tar.zst \
#     -t cosmium:cpu .

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    cabextract \
    dbus-user-session \
    fontconfig \
    fonts-liberation \
    fonts-noto \
    fonts-noto-color-emoji \
    fonts-noto-cjk \
    fonts-dejavu-core \
    fonts-freefont-ttf \
    fonts-ipafont-gothic \
    fonts-tlwg-loma-otf \
    fonts-ubuntu \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgl1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpulse0 \
    libsecret-1-0 \
    libwayland-client0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxshmfence1 \
    libxss1 \
    libxtst6 \
    locales \
    procps \
    pulseaudio \
    pulseaudio-utils \
    tini \
    tzdata \
    wget \
    xdg-utils \
    xfonts-utils \
    zstd \
 && locale-gen en_US.UTF-8 \
 && rm -rf /var/lib/apt/lists/* \
 && fc-cache -f

# ttf-mscorefonts for Windows-persona profiles.
RUN (wget -q -O /tmp/msfonts.deb \
    http://archive.ubuntu.com/ubuntu/pool/multiverse/m/msttcorefonts/ttf-mscorefonts-installer_3.8.1_all.deb \
 && apt-get update && apt-get install -y /tmp/msfonts.deb \
 && rm -rf /tmp/msfonts.deb /var/lib/apt/lists/*) || true \
 && fc-cache -f

# PulseAudio "null" sink so AudioContext / MediaDevices.enumerateDevices()
# can advertise a working audio device even without real hardware. Combined
# with the media_devices spoof (patch 0010), this gives a coherent surface.
RUN mkdir -p /etc/pulse && \
    echo "load-module module-null-sink sink_name=cosmium_null sink_properties=device.description=Cosmium-Audio" \
    >> /etc/pulse/default.pa

ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} cosmium && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash cosmium

ARG COSMIUM_TARBALL
COPY ${COSMIUM_TARBALL} /tmp/cosmium.tar.zst
RUN mkdir -p /opt/cosmium && \
    tar --use-compress-program=zstd -xf /tmp/cosmium.tar.zst -C /opt/cosmium --strip-components=1 && \
    rm /tmp/cosmium.tar.zst && \
    chown -R cosmium:cosmium /opt/cosmium

RUN chmod 4755 /opt/cosmium/chrome_sandbox 2>/dev/null || true

ENV PATH="/opt/cosmium:${PATH}" \
    CHROME_DEVEL_SANDBOX=/opt/cosmium/chrome_sandbox

USER cosmium
WORKDIR /home/cosmium

COPY docker/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["--help"]
