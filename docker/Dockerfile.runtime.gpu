# cosmium runtime image — GPU variant.
#
# Pairs with nvidia-docker (`--gpus all`). The GPU passthrough produces real
# WebGL/canvas/WebGPU output, so the only patches needed are spoofing the
# brand strings + nav properties — pixel-level fingerprints are clean.
#
# Build:
#   docker build -f docker/Dockerfile.runtime.gpu \
#     --build-arg COSMIUM_TARBALL=dist/cosmium-135.0.7049.84.tar.zst \
#     -t cosmium:gpu .
#
# Run:
#   docker run --rm --gpus all --cap-add SYS_ADMIN \
#     -v $PWD/profiles:/profiles:ro \
#     cosmium:gpu \
#     --cosmium-profile=/profiles/win11_rtx3060_en-us.json \
#     --headless=new https://browserleaks.com/webgl

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,graphics,utility,video,display

# Runtime libraries Chromium dynamically links. Match real Chrome's runtime
# surface so a chroot/strace probe doesn't reveal a thinner-than-Chrome
# library set.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    dbus-user-session \
    fontconfig \
    fonts-liberation \
    fonts-noto \
    fonts-noto-color-emoji \
    fonts-noto-cjk \
    fonts-dejavu-core \
    fonts-freefont-ttf \
    fonts-ipafont-gothic \
    fonts-tlwg-loma-otf \
    fonts-ubuntu \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgl1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpulse0 \
    libsecret-1-0 \
    libwayland-client0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxshmfence1 \
    libxss1 \
    libxtst6 \
    locales \
    procps \
    pulseaudio-utils \
    tini \
    tzdata \
    wget \
    xdg-utils \
    zstd \
 && locale-gen en_US.UTF-8 \
 && rm -rf /var/lib/apt/lists/* \
 && fc-cache -f

# ---- Install ttf-mscorefonts (Arial, Times New Roman, etc.) ----
# These are critical for matching Windows-persona profiles. Real Windows has
# them; Linux containers don't unless explicitly installed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    cabextract xfonts-utils \
 && wget -q -O /tmp/msfonts.deb \
    http://archive.ubuntu.com/ubuntu/pool/multiverse/m/msttcorefonts/ttf-mscorefonts-installer_3.8.1_all.deb \
 && (apt-get install -y /tmp/msfonts.deb || true) \
 && rm -rf /tmp/msfonts.deb /var/lib/apt/lists/* \
 && fc-cache -f

# ---- Non-root user ----
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} cosmium && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash cosmium

# ---- Unpack cosmium tarball ----
ARG COSMIUM_TARBALL
COPY ${COSMIUM_TARBALL} /tmp/cosmium.tar.zst
RUN mkdir -p /opt/cosmium && \
    tar --use-compress-program=zstd -xf /tmp/cosmium.tar.zst -C /opt/cosmium --strip-components=1 && \
    rm /tmp/cosmium.tar.zst && \
    chown -R cosmium:cosmium /opt/cosmium

# ---- Suid sandbox ----
# Chromium's setuid sandbox is required when not running with --no-sandbox.
# We prefer keeping the sandbox enabled — --no-sandbox is itself a fingerprint
# tell on some detection sites that probe sandbox status.
RUN chmod 4755 /opt/cosmium/chrome_sandbox 2>/dev/null || true

ENV PATH="/opt/cosmium:${PATH}" \
    CHROME_DEVEL_SANDBOX=/opt/cosmium/chrome_sandbox

USER cosmium
WORKDIR /home/cosmium

COPY docker/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["--help"]
