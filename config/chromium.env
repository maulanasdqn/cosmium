# Sourced by all build scripts. Edit local overrides in .env (gitignored).

# Pin file is the source of truth for the Chromium tag.
CHROMIUM_TAG="$(cat "${COSMIUM_ROOT}/VERSION" | tr -d '[:space:]')"

# Source tree location (gitignored, ~40GB).
CHROMIUM_SRC="${COSMIUM_ROOT}/src"

# depot_tools location (gitignored).
DEPOT_TOOLS="${COSMIUM_ROOT}/depot_tools"

# Build output directory (gitignored).
BUILD_OUT="${COSMIUM_ROOT}/out/cosmium"

# Distribution output (gitignored).
DIST_DIR="${COSMIUM_ROOT}/dist"

# Build target. `chrome` = full browser. `headless_shell` = headless-only (NOT what we want — too easy to fingerprint).
BUILD_TARGET="chrome"

# Parallel build jobs. autoninja autodetects; override here if needed.
# NINJA_JOBS=12

# Load local overrides last so they win.
if [[ -f "${COSMIUM_ROOT}/.env" ]]; then
  # shellcheck source=/dev/null
  source "${COSMIUM_ROOT}/.env"
fi
