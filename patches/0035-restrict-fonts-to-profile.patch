+namespace {
+
+std::optional<base::flat_set<std::string>> CosmiumParseAllowedFonts() {
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (!cosmium_cmd->HasSwitch("cosmium-fonts")) {
+    return std::nullopt;
+  }
+  std::vector<std::string> cosmium_names;
+  for (const auto& cosmium_name :
+       base::SplitString(cosmium_cmd->GetSwitchValueASCII("cosmium-fonts"),
+                         ",", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    cosmium_names.push_back(base::ToLowerASCII(cosmium_name));
+  }
+  if (cosmium_names.empty()) {
+    return std::nullopt;
+  }
+  return base::flat_set<std::string>(std::move(cosmium_names));
+}
+
+bool CosmiumFontAllowed(const FontPlatformData* platform_data) {
+  static const base::NoDestructor<std::optional<base::flat_set<std::string>>>
+      cosmium_allowed(CosmiumParseAllowedFonts());
+  if (!cosmium_allowed->has_value() || !platform_data ||
+      !platform_data->Typeface()) {
+    return true;
+  }
+  SkString cosmium_family;
+  platform_data->Typeface()->getFamilyName(&cosmium_family);
+  return (*cosmium_allowed)
+      ->contains(base::ToLowerASCII(
+          std::string_view(cosmium_family.c_str(), cosmium_family.size())));
+}
+
+}  // namespace
