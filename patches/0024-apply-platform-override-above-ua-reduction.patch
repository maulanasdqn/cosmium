 String NavigatorBase::platform() const {
+  // cosmium: this override has to sit above the user-agent reduction branches
+  // below. From reduction phase 5 onward ReduceUserAgentPlatformOsCpu is on by
+  // default on desktop, so this function returns the frozen
+  // GetReducedNavigatorPlatform() string and NavigatorID::platform() -- where
+  // the --cosmium-platform hook lives -- is never reached. Checking here keeps
+  // that hook working as the fallback for contexts where reduction is off.
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (cosmium_cmd->HasSwitch("cosmium-platform")) {
+    return String::FromUTF8(
+        cosmium_cmd->GetSwitchValueASCII("cosmium-platform"));
+  }
+
   ExecutionContext* execution_context = GetExecutionContext();
 
 #if BUILDFLAG(IS_ANDROID)
