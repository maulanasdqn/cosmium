+// cosmium: the avail* quartet is spoofed alongside width/height on purpose.
+// Reporting a 1920x1080 screen whose available area is still the headless
+// 800x600 is a contradiction no real display produces, and detectors compare
+// the two. The profile carries the pair explicitly -- avail_height 1032 against
+// height 1080 is the Windows 11 taskbar -- so the difference stays plausible.
 int Screen::availLeft() const {
+  int cosmium_value = 0;
+  if (CosmiumScreenInt("cosmium-avail-left", &cosmium_value))
+    return cosmium_value;
   if (!DomWindow())
     return 0;
   return GetRect(/*available=*/true).x();
 }
 
