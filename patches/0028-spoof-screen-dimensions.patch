 int Screen::height() const {
+  int cosmium_value = 0;
+  if (CosmiumScreenInt("cosmium-screen-height", &cosmium_value))
+    return cosmium_value;
   if (!DomWindow())
     return 0;
   return GetRect(/*available=*/false).height();
 }
 
