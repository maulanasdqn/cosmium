 namespace {
 
+// cosmium: read an integer screen dimension from the command line. Returns
+// false when the switch is absent or unparseable so the caller falls through
+// to the real value rather than reporting a zero.
+bool CosmiumScreenInt(const char* switch_name, int* out) {
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (!cosmium_cmd->HasSwitch(switch_name))
+    return false;
+  return base::StringToInt(cosmium_cmd->GetSwitchValueASCII(switch_name), out);
+}
+
 }  // namespace
 
