# cosmium patch: 0010-spoof-audio-context-latency
# Authored: 2026-05-17
# Chromium base: see ../VERSION
#
# Describe the detection vector this patch fixes:
# - target file(s): third_party/blink/renderer/modules/webaudio/audio_context.cc
# - what changed: AudioContext::baseLatency and AudioContext::outputLatency
#                 consult --cosmium-audio-base-latency / --cosmium-audio-output-latency
# - profile fields read: audio.base_latency, audio.output_latency
# - test: new AudioContext().baseLatency / .outputLatency
#         (CreepJS "Audio" probe — base/output latency contribute to hash)
diff --git a/third_party/blink/renderer/modules/webaudio/audio_context.cc b/third_party/blink/renderer/modules/webaudio/audio_context.cc
--- a/third_party/blink/renderer/modules/webaudio/audio_context.cc
+++ b/third_party/blink/renderer/modules/webaudio/audio_context.cc
@@ -5,5 +5,7 @@
 #include "third_party/blink/renderer/modules/webaudio/audio_context.h"
 
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/metrics/histogram_macros.h"
 #include "base/strings/to_string.h"
@@ -638,4 +640,13 @@
 double AudioContext::baseLatency() const {
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (cosmium_cmd->HasSwitch("cosmium-audio-base-latency")) {
+    double cosmium_value = 0.0;
+    if (base::StringToDouble(
+            cosmium_cmd->GetSwitchValueASCII("cosmium-audio-base-latency"),
+            &cosmium_value)) {
+      return cosmium_value;
+    }
+  }
   DCHECK_CALLED_ON_VALID_SEQUENCE(main_thread_sequence_checker_);
   DCHECK(destination());
 
@@ -645,4 +656,13 @@
 double AudioContext::outputLatency() const {
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (cosmium_cmd->HasSwitch("cosmium-audio-output-latency")) {
+    double cosmium_value = 0.0;
+    if (base::StringToDouble(
+            cosmium_cmd->GetSwitchValueASCII("cosmium-audio-output-latency"),
+            &cosmium_value)) {
+      return cosmium_value;
+    }
+  }
   DCHECK_CALLED_ON_VALID_SEQUENCE(main_thread_sequence_checker_);
   DCHECK(destination());
 
