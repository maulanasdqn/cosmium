+struct CosmiumGlLimit {
+  GLint first;
+  GLint second;
+  bool has_second;
+};
+
+const base::flat_map<std::string, GLenum>& CosmiumLimitNames() {
+  static const base::NoDestructor<base::flat_map<std::string, GLenum>> names({
+      {"MAX_TEXTURE_SIZE", GL_MAX_TEXTURE_SIZE},
+      {"MAX_CUBE_MAP_TEXTURE_SIZE", GL_MAX_CUBE_MAP_TEXTURE_SIZE},
+      {"MAX_RENDERBUFFER_SIZE", GL_MAX_RENDERBUFFER_SIZE},
+      {"MAX_VIEWPORT_DIMS", GL_MAX_VIEWPORT_DIMS},
+      {"MAX_3D_TEXTURE_SIZE", GL_MAX_3D_TEXTURE_SIZE},
+      {"MAX_ARRAY_TEXTURE_LAYERS", GL_MAX_ARRAY_TEXTURE_LAYERS},
+      {"MAX_SAMPLES", GL_MAX_SAMPLES},
+      {"MAX_VERTEX_UNIFORM_VECTORS", GL_MAX_VERTEX_UNIFORM_VECTORS},
+      {"MAX_FRAGMENT_UNIFORM_VECTORS", GL_MAX_FRAGMENT_UNIFORM_VECTORS},
+      {"MAX_VARYING_VECTORS", GL_MAX_VARYING_VECTORS},
+      {"MAX_TEXTURE_IMAGE_UNITS", GL_MAX_TEXTURE_IMAGE_UNITS},
+      {"MAX_COMBINED_TEXTURE_IMAGE_UNITS", GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS},
+      {"MAX_DRAW_BUFFERS", GL_MAX_DRAW_BUFFERS},
+      {"MAX_COLOR_ATTACHMENTS", GL_MAX_COLOR_ATTACHMENTS},
+  });
+  return *names;
+}
+
+base::flat_map<GLenum, CosmiumGlLimit> CosmiumParseGlLimits() {
+  base::flat_map<GLenum, CosmiumGlLimit> parsed;
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (!cosmium_cmd->HasSwitch("cosmium-webgl-limits")) {
+    return parsed;
+  }
+  const std::string cosmium_raw =
+      cosmium_cmd->GetSwitchValueASCII("cosmium-webgl-limits");
+  for (const auto& cosmium_entry :
+       base::SplitString(cosmium_raw, ",", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    const std::vector<std::string> cosmium_pair = base::SplitString(
+        cosmium_entry, "=", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (cosmium_pair.size() != 2) {
+      continue;
+    }
+    const auto cosmium_name = CosmiumLimitNames().find(cosmium_pair[0]);
+    if (cosmium_name == CosmiumLimitNames().end()) {
+      continue;
+    }
+    const std::vector<std::string> cosmium_dims = base::SplitString(
+        cosmium_pair[1], "x", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (cosmium_dims.empty() || cosmium_dims.size() > 2) {
+      continue;
+    }
+    int cosmium_first = 0;
+    if (!base::StringToInt(cosmium_dims[0], &cosmium_first) ||
+        cosmium_first <= 0) {
+      continue;
+    }
+    int cosmium_second = 0;
+    const bool cosmium_has_second = cosmium_dims.size() == 2;
+    if (cosmium_has_second &&
+        (!base::StringToInt(cosmium_dims[1], &cosmium_second) ||
+         cosmium_second <= 0)) {
+      continue;
+    }
+    parsed[cosmium_name->second] = CosmiumGlLimit{
+        cosmium_first, cosmium_second, cosmium_has_second};
+  }
+  return parsed;
+}
+
+const base::flat_map<GLenum, CosmiumGlLimit>& CosmiumGlLimits() {
+  static const base::NoDestructor<base::flat_map<GLenum, CosmiumGlLimit>>
+      limits(CosmiumParseGlLimits());
+  return *limits;
+}
+
+base::flat_set<std::string> CosmiumParseExcludedExtensions() {
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (!cosmium_cmd->HasSwitch("cosmium-webgl-exclude-extensions")) {
+    return {};
+  }
+  const std::vector<std::string> cosmium_names = base::SplitString(
+      cosmium_cmd->GetSwitchValueASCII("cosmium-webgl-exclude-extensions"), ",",
+      base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  return base::flat_set<std::string>(cosmium_names.begin(),
+                                     cosmium_names.end());
+}
+
+const base::flat_set<std::string>& CosmiumExcludedExtensions() {
+  static const base::NoDestructor<base::flat_set<std::string>> excluded(
+      CosmiumParseExcludedExtensions());
+  return *excluded;
+}
