@@ -405,6 +465,20 @@ TtsPlatformImplLinux::TtsPlatformImplLinux()
   DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
   const base::CommandLine& command_line =
       *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch("cosmium-voices")) {
+    cosmium_voices_ =
+        ParseCosmiumVoices(command_line.GetSwitchValueASCII("cosmium-voices"));
+    if (!cosmium_voices_.empty()) {
+      cosmium_mode_ = true;
+      is_supported_ = true;
+      is_initialized_ = true;
+      GetUIThreadTaskRunner({})->PostTask(
