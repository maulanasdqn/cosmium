+            TtsController::GetInstance()->VoicesChanged();
+          }));
+      return;
+    }
+  }
   if (!command_line.HasSwitch(switches::kEnableSpeechDispatcher))
     return;
 
@@ -443,6 +517,16 @@ void TtsPlatformImplLinux::Speak(
   is_speaking_ = true;
   utterance_id_ = utterance_id;
 
+  if (cosmium_mode_) {
+    std::move(on_speak_finished).Run(true);
+    GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(&TtsPlatformImplLinux::FinishCosmiumUtterance,
+                       base::Unretained(this), utterance_id,
+                       static_cast<int>(utterance.size())));
+    return;
+  }
+
   // Parse SSML and process speech.
   TtsController::GetInstance()->StripSSML(
       utterance,
@@ -457,6 +541,13 @@ bool TtsPlatformImplLinux::StopSpeaking() {
   DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
   DCHECK(PlatformImplInitialized());
 
+  if (cosmium_mode_) {
+    paused_ = false;
+    is_speaking_ = false;
+    utterance_id_ = kInvalidUtteranceId;
+    return true;
+  }
+
   worker_.AsyncCall(&TtsPlatformImplBackgroundWorker::StopSpeaking);
   paused_ = false;
 
@@ -470,7 +561,7 @@ void TtsPlatformImplLinux::Pause() {
   DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
   DCHECK(PlatformImplInitialized());
 
-  if (paused_ || !is_speaking_)
+  if (paused_ || !is_speaking_ || cosmium_mode_)
     return;
 
   worker_.AsyncCall(&TtsPlatformImplBackgroundWorker::Pause);
@@ -481,7 +572,7 @@ void TtsPlatformImplLinux::Resume() {
   DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
   DCHECK(PlatformImplInitialized());
 
-  if (!paused_ || !is_speaking_)
+  if (!paused_ || !is_speaking_ || cosmium_mode_)
     return;
 
   worker_.AsyncCall(&TtsPlatformImplBackgroundWorker::Resume);
@@ -496,6 +587,13 @@ void TtsPlatformImplLinux::GetVoices(std::vector<VoiceData>* out_voices) {
   DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
   DCHECK(PlatformImplInitialized());
 
+  if (cosmium_mode_) {
+    for (const VoiceData& voice : cosmium_voices_) {
+      out_voices->push_back(voice);
+    }
+    return;
+  }
+
   for (auto it = voices_.begin(); it != voices_.end(); ++it) {
     out_voices->push_back(VoiceData());
     VoiceData& voice = out_voices->back();
@@ -511,7 +609,24 @@ void TtsPlatformImplLinux::GetVoices(std::vector<VoiceData>* out_voices) {
   }
 }
 
+void TtsPlatformImplLinux::FinishCosmiumUtterance(int utterance_id,
+                                                  int length) {
+  DCHECK(BrowserThread::CurrentlyOn(content::BrowserThread::UI));
+  if (utterance_id != utterance_id_) {
+    return;
+  }
+  TtsController* controller = TtsController::GetInstance();
+  controller->OnTtsEvent(utterance_id, TTS_EVENT_START, 0, -1, std::string());
+  is_speaking_ = false;
+  utterance_id_ = kInvalidUtteranceId;
+  controller->OnTtsEvent(utterance_id, TTS_EVENT_END, length, 0,
+                         std::string());
+}
+
 void TtsPlatformImplLinux::Shutdown() {
+  if (cosmium_mode_) {
+    return;
+  }
   worker_.AsyncCall(&TtsPlatformImplBackgroundWorker::Shutdown);
 }
 
