# cosmium patch: 0031-spoof-speech-synthesis-voices
# Authored: 2026-10-01
# Chromium base: see ../VERSION
#
# Describe the detection vector this patch fixes:
# - target file(s): content/browser/speech/tts_linux.cc
# - what changed: With --cosmium-voices=<json array> the Linux TTS platform
#                 reports itself supported and initialized without
#                 speech-dispatcher and serves exactly the profile voices
#                 (default voice first, localService -> !remote). speak()
#                 does not synthesize audio; it fires start and end events
#                 so utterances never hang.
# - profile fields read: voices[] (name, lang, default, localService)
# - test: speechSynthesis.getVoices() after voiceschanged lists the profile
#         voices with matching name/lang/localService/default under
#         --headless=new; an utterance fires onstart then onend.
diff --git a/content/browser/speech/tts_linux.cc b/content/browser/speech/tts_linux.cc
index dcfb2d419c..a1e424cab8 100644
--- a/content/browser/speech/tts_linux.cc
+++ b/content/browser/speech/tts_linux.cc
@@ -13,6 +13,8 @@
 #include "base/compiler_specific.h"
 #include "base/debug/leak_annotations.h"
 #include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
 #include "base/memory/raw_ptr.h"
 #include "base/no_destructor.h"
 #include "base/synchronization/lock.h"
@@ -161,8 +163,66 @@ class TtsPlatformImplLinux : public TtsPlatformImpl {
 
   // Hold the state and the code of the background implementation.
   base::SequenceBound<TtsPlatformImplBackgroundWorker> worker_;
+
+  // cosmium: voices supplied by --cosmium-voices. When non-empty the platform
+  // serves them directly and never touches speech-dispatcher.
+  void FinishCosmiumUtterance(int utterance_id, int length);
+  bool cosmium_mode_ = false;
+  std::vector<VoiceData> cosmium_voices_;
 };
 
+namespace {
+
+// cosmium: parse the profile voice list. The default voice is placed first
+// because the speech synthesis service marks the first voice as the default,
+// and voiceURI is always the voice name on the web side.
+std::vector<VoiceData> ParseCosmiumVoices(const std::string& json) {
+  std::vector<VoiceData> voices;
+  std::optional<base::ListValue> list =
+      base::JSONReader::ReadList(json, base::JSON_PARSE_RFC);
+  if (!list) {
+    return voices;
+  }
+  std::vector<VoiceData> rest;
+  for (const base::Value& item : *list) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::DictValue& dict = item.GetDict();
+    const std::string* name = dict.FindString("name");
+    const std::string* lang = dict.FindString("lang");
+    if (!name || name->empty()) {
+      continue;
+    }
+    std::optional<bool> local = dict.FindBool("localService");
+    if (!local) {
+      local = dict.FindBool("local_service");
+    }
+    const bool is_default = dict.FindBool("default").value_or(false);
+    VoiceData voice;
+    voice.native = true;
+    voice.name = *name;
+    voice.lang = lang ? *lang : std::string();
+    voice.remote = !local.value_or(true);
+    voice.events.insert(TTS_EVENT_START);
+    voice.events.insert(TTS_EVENT_END);
+    voice.events.insert(TTS_EVENT_CANCELLED);
+    voice.events.insert(TTS_EVENT_PAUSE);
+    voice.events.insert(TTS_EVENT_RESUME);
+    if (is_default && voices.empty()) {
+      voices.push_back(std::move(voice));
+    } else {
+      rest.push_back(std::move(voice));
+    }
+  }
+  for (VoiceData& voice : rest) {
+    voices.push_back(std::move(voice));
+  }
+  return voices;
+}
+
+}  // namespace
+
