   base::AutoLock locker(instance().lock_);
 
+  // cosmium: Init() applies --cosmium-timezone and then binds this
+  // TimeZoneMonitor client, and the browser answers by pushing the real host
+  // zone -- which lands here and would overwrite the override before any JS
+  // runs. The switch wins here too, and it is recorded as the host zone so a
+  // cleared DevTools override restores the spoofed zone, not the real one.
+  const String cosmium_tz = CosmiumTimezoneId();
+  const String& effective_id = cosmium_tz.empty() ? timezone_id : cosmium_tz;
+
   // Remember requested timezone id so we can set it when timezone
   // override is removed.
-  instance().host_timezone_id_ = timezone_id;
+  instance().host_timezone_id_ = effective_id;
 
   if (!HasTimeZoneOverride())
-    SetIcuTimeZoneAndNotifyV8(timezone_id);
+    SetIcuTimeZoneAndNotifyV8(effective_id);
 }
 
