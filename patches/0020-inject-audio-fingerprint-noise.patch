# cosmium patch: 0020-inject-audio-fingerprint-noise
# Authored: 2026-08-08
# Chromium base: see ../VERSION
#
# Describe the detection vector this patch fixes:
# - target file(s): third_party/blink/renderer/modules/webaudio/audio_buffer.{h,cc}
# - what changed: AudioBuffer::getChannelData and AudioBuffer::copyFromChannel
#                 inject subtle deterministic noise when --cosmium-canvas-seed is set.
#                 Noise is seeded by the canvas seed value, applied once per buffer
#                 on first data access. Magnitude ±1e-7 is inaudible but changes
#                 the fingerprint hash computed by AudioContext fingerprinting scripts.
# - profile fields read: canvas_seed (shared with canvas fingerprint protection)
# - test: create OfflineAudioContext, render OscillatorNode through
#         DynamicsCompressorNode, read getChannelData() — hash must change per seed.
#         (DataDome / CreepJS "Audio" probe — rendered buffer hash is a key signal)
diff --git a/third_party/blink/renderer/modules/webaudio/audio_buffer.cc b/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
index bc4c0c6ca0..da2cd99e54 100644
--- a/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
+++ b/third_party/blink/renderer/modules/webaudio/audio_buffer.cc
@@ -30,8 +30,10 @@
 
 #include <memory>
 
+#include "base/command_line.h"
 #include "base/compiler_specific.h"
 #include "base/containers/span.h"
+#include "base/strings/string_number_conversions.h"
 #include "third_party/blink/renderer/bindings/modules/v8/v8_audio_buffer_options.h"
 #include "third_party/blink/renderer/modules/webaudio/base_audio_context.h"
 #include "third_party/blink/renderer/platform/audio/audio_bus.h"
@@ -216,11 +218,76 @@ NotShared<DOMFloat32Array> AudioBuffer::getChannelData(
   return getChannelData(channel_index);
 }
 
+// Cosmium: deterministic hash for audio fingerprint noise injection
+static uint32_t CosmiumAudioHash(uint64_t seed,
+                                 unsigned channel,
+                                 size_t index) {
+  uint64_t h = seed;
+  h ^= static_cast<uint64_t>(channel) * 0x9E3779B97F4A7C15ULL;
+  h ^= static_cast<uint64_t>(index) * 0x517CC1B727220A95ULL;
+  h = (h ^ (h >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  h = (h ^ (h >> 27)) * 0x94D049BB133111EBULL;
+  h = h ^ (h >> 31);
+  return static_cast<uint32_t>(h);
+}
+
+// Cosmium: the profile seed is usually a hex string, not a decimal integer.
+// Hash non-numeric seeds (FNV-1a, matching the canvas noise path) instead of
+// rejecting them, which silently disabled audio noise.
+static uint64_t CosmiumAudioSeed(const std::string& seed_str) {
+  uint64_t seed = 0;
+  if (base::StringToUint64(seed_str, &seed)) {
+    return seed;
+  }
+  uint64_t h = 14695981039346656037ULL;
+  for (char c : seed_str) {
+    h ^= static_cast<uint64_t>(static_cast<unsigned char>(c));
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
+
+// Cosmium: apply subtle deterministic noise to all channels on first access.
+// Uses --cosmium-canvas-seed for consistent cross-session noise.
+void AudioBuffer::MaybeInjectCosmiumNoise() {
+  if (cosmium_noise_injected_) {
+    return;
+  }
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (!cosmium_cmd->HasSwitch("cosmium-canvas-seed")) {
+    return;
+  }
+  const std::string seed_str =
+      cosmium_cmd->GetSwitchValueASCII("cosmium-canvas-seed");
+  if (seed_str.empty()) {
+    return;
+  }
+  const uint64_t cosmium_seed = CosmiumAudioSeed(seed_str);
+  cosmium_noise_injected_ = true;
+  for (unsigned ch = 0; ch < channels_.size(); ++ch) {
+    DOMFloat32Array* channel_data = channels_[ch].Get();
+    if (!channel_data) {
+      continue;
+    }
+    base::span<float> data = channel_data->AsSpan();
+    for (size_t i = 0; i < data.size(); ++i) {
+      uint32_t hash = CosmiumAudioHash(cosmium_seed, ch, i);
+      // Noise in [-1e-7, 1e-7]: inaudible but changes fingerprint hash
+      float noise =
+          (static_cast<float>(hash & 0xFFFF) / 65535.0f - 0.5f) * 2e-7f;
+      data[i] += noise;
+    }
+  }
+}
+
 NotShared<DOMFloat32Array> AudioBuffer::getChannelData(unsigned channel_index) {
   if (channel_index >= channels_.size()) {
     return NotShared<DOMFloat32Array>(nullptr);
   }
 
+  // Cosmium: inject deterministic noise for audio fingerprint protection
+  MaybeInjectCosmiumNoise();
+
   return NotShared<DOMFloat32Array>(channels_[channel_index].Get());
 }
 
@@ -251,6 +318,9 @@ void AudioBuffer::copyFromChannel(NotShared<DOMFloat32Array> destination,
     return;
   }
 
+  // Cosmium: inject deterministic noise for audio fingerprint protection
+  MaybeInjectCosmiumNoise();
+
   base::span<const float> src = channels_[channel_number].Get()->AsSpan();
   base::span<float> dst = destination->AsSpan();
 
diff --git a/third_party/blink/renderer/modules/webaudio/audio_buffer.h b/third_party/blink/renderer/modules/webaudio/audio_buffer.h
index 4bbf70b439..b02eaa8010 100644
--- a/third_party/blink/renderer/modules/webaudio/audio_buffer.h
+++ b/third_party/blink/renderer/modules/webaudio/audio_buffer.h
@@ -119,8 +119,14 @@ class MODULES_EXPORT AudioBuffer final : public ScriptWrappable {
  private:
   bool CreatedSuccessfully(unsigned desired_number_of_channels) const;
 
+  // Cosmium: inject deterministic noise into audio buffer for fingerprint
+  // protection. Applied once on first data access when --cosmium-canvas-seed
+  // is set.
+  void MaybeInjectCosmiumNoise();
+
   float sample_rate_;
   uint32_t length_;
+  bool cosmium_noise_injected_ = false;  // Cosmium: audio noise tracking
 
   HeapVector<Member<DOMFloat32Array>> channels_;
 };
