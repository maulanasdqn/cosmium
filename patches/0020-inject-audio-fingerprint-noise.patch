+// Cosmium: deterministic hash for audio fingerprint noise injection
+static uint32_t CosmiumAudioHash(uint64_t seed,
+                                 unsigned channel,
+                                 size_t index) {
+  uint64_t h = seed;
+  h ^= static_cast<uint64_t>(channel) * 0x9E3779B97F4A7C15ULL;
+  h ^= static_cast<uint64_t>(index) * 0x517CC1B727220A95ULL;
+  h = (h ^ (h >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  h = (h ^ (h >> 27)) * 0x94D049BB133111EBULL;
+  h = h ^ (h >> 31);
+  return static_cast<uint32_t>(h);
+}
+
+// Cosmium: apply subtle deterministic noise to all channels on first access.
+// Uses --cosmium-canvas-seed for consistent cross-session noise.
+void AudioBuffer::MaybeInjectCosmiumNoise() {
+  if (cosmium_noise_injected_) {
+    return;
+  }
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (!cosmium_cmd->HasSwitch("cosmium-canvas-seed")) {
+    return;
+  }
+  uint64_t cosmium_seed = 0;
+  if (!base::StringToUint64(
+          cosmium_cmd->GetSwitchValueASCII("cosmium-canvas-seed"),
+          &cosmium_seed)) {
+    return;
+  }
+  cosmium_noise_injected_ = true;
+  for (unsigned ch = 0; ch < channels_.size(); ++ch) {
+    DOMFloat32Array* channel_data = channels_[ch].Get();
+    if (!channel_data) {
+      continue;
+    }
+    float* data = channel_data->Data();
+    size_t len = channel_data->length();
+    for (size_t i = 0; i < len; ++i) {
+      uint32_t hash = CosmiumAudioHash(cosmium_seed, ch, i);
+      // Noise in [-1e-7, 1e-7]: inaudible but changes fingerprint hash
+      float noise =
+          (static_cast<float>(hash & 0xFFFF) / 65535.0f - 0.5f) * 2e-7f;
+      data[i] += noise;
+    }
+  }
+}
+
 NotShared<DOMFloat32Array> AudioBuffer::getChannelData(
     unsigned channel_index,
     ExceptionState& exception_state) {
@@ -222,6 +271,9 @@ NotShared<DOMFloat32Array> AudioBuffer::getChannelData(unsigned channel_index) {
     return NotShared<DOMFloat32Array>(nullptr);
   }
 
+  // Cosmium: inject deterministic noise for audio fingerprint protection
+  MaybeInjectCosmiumNoise();
+
   return NotShared<DOMFloat32Array>(channels_[channel_index].Get());
 }
 
