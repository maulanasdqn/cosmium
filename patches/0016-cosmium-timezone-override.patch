 // static
 void TimeZoneController::Init() {
+  // Cosmium: override timezone from command line before any JS runs,
+  // so Intl.DateTimeFormat().resolvedOptions().timeZone matches the
+  // proxy IP geolocation and doesn't trigger bot detectors.
+  const auto* cosmium_cmd = base::CommandLine::ForCurrentProcess();
+  if (cosmium_cmd->HasSwitch("cosmium-timezone")) {
+    std::string tz = cosmium_cmd->GetSwitchValueASCII("cosmium-timezone");
+    if (!tz.empty()) {
+      SetIcuTimeZoneAndNotifyV8(String::FromUTF8(tz));
+    }
+  }
+
   // monitor must not use HeapMojoRemote. TimeZoneController is not managed by
   // Oilpan. monitor is only used to bind receiver_ here and never used
   // again.
